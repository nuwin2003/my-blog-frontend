{
  "info": {
    "_postman_id": "8f844cae-0d5d-44ba-a50c-c5794dc370af",
    "name": "Developer Blog API",
    "description": "Frontend-ready collection for the Developer Blog REST API. Run Admin Login first to automatically save the JWT. Create Category and Create Post automatically save their returned IDs and slug for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwtToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwtToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "postSlug", "value": "building-reliable-node-apis" }
  ],
  "item": [
    {
      "name": "System",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Checks whether the API process is running."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Admin Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "if (json.data && json.data.token) pm.collectionVariables.set('jwtToken', json.data.token);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "admin", "login"] },
            "description": "Authenticates the admin. The test script stores data.token as the collection jwtToken."
          }
        }
      ]
    },
    {
      "name": "Public Posts",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List Published Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?limit=10&offset=0&sort=newest&category=&tag=&search=",
              "host": ["{{baseUrl}}"], "path": ["api", "posts"],
              "query": [
                { "key": "limit", "value": "10", "description": "1–100" },
                { "key": "offset", "value": "0" },
                { "key": "sort", "value": "newest", "description": "newest or oldest" },
                { "key": "category", "value": "", "description": "Category slug", "disabled": true },
                { "key": "tag", "value": "", "description": "Tag slug", "disabled": true },
                { "key": "search", "value": "", "description": "Case-insensitive title search", "disabled": true }
              ]
            },
            "description": "Returns published posts and pagination metadata."
          }
        },
        {
          "name": "Get Published Post by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/posts/{{postSlug}}", "host": ["{{baseUrl}}"], "path": ["api", "posts", "{{postSlug}}"] }
          }
        }
      ]
    },
    {
      "name": "Public Categories",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] },
            "description": "Returns categories alphabetically with published post counts in _count.posts."
          }
        }
      ]
    },
    {
      "name": "Admin Posts",
      "item": [
        {
          "name": "List All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/posts?limit=10&offset=0&sort=newest&status=",
              "host": ["{{baseUrl}}"], "path": ["api", "admin", "posts"],
              "query": [
                { "key": "limit", "value": "10" }, { "key": "offset", "value": "0" },
                { "key": "sort", "value": "newest" },
                { "key": "status", "value": "", "description": "draft, published, or archived", "disabled": true },
                { "key": "category", "value": "", "description": "Category slug", "disabled": true },
                { "key": "tag", "value": "", "description": "Tag slug", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Post",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Post created', function () { pm.response.to.have.status(201); });",
                "const json = pm.response.json();",
                "if (json.data) {",
                "  pm.collectionVariables.set('postId', json.data.id);",
                "  pm.collectionVariables.set('postSlug', json.data.slug);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Building a Type-Safe Express API", "type": "text" },
                { "key": "excerpt", "value": "Practical patterns for an Express and Prisma backend.", "type": "text" },
                { "key": "content", "value": "# Building a Type-Safe Express API\n\nWrite the post content here in Markdown.", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "tags", "value": "[\"node.js\",\"express\",\"prisma\"]", "type": "text", "description": "JSON-encoded string array" },
                { "key": "externalUrls", "value": "[{\"label\":\"Express documentation\",\"url\":\"https://expressjs.com/\"}]", "type": "text", "description": "JSON-encoded array of {label,url}" },
                { "key": "status", "value": "draft", "type": "text" },
                { "key": "readTimeMinutes", "value": "6", "type": "text" },
                { "key": "coverImage", "type": "file", "src": [], "description": "Optional JPEG, PNG, WebP, or GIF" },
                { "key": "images", "type": "file", "src": [], "description": "Optional embedded image; duplicate this row for up to 10 files", "disabled": true }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/admin/posts", "host": ["{{baseUrl}}"], "path": ["api", "admin", "posts"] },
            "description": "Multipart request. Do not manually set Content-Type; Postman adds the boundary. Image fields are optional."
          }
        },
        {
          "name": "Update Post (Partial)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data && json.data.slug) pm.collectionVariables.set('postSlug', json.data.slug);"] }
          }],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Building a Production-Ready Express API", "type": "text" },
                { "key": "status", "value": "published", "type": "text" },
                { "key": "tags", "value": "[\"node.js\",\"express\",\"prisma\"]", "type": "text" },
                { "key": "externalUrls", "value": "[{\"label\":\"Prisma documentation\",\"url\":\"https://www.prisma.io/docs\"}]", "type": "text", "disabled": true },
                { "key": "coverImage", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/admin/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "posts", "{{postId}}"] },
            "description": "Only enabled fields are updated. Enabling coverImage replaces and deletes the old local cover file."
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "posts", "{{postId}}"] },
            "description": "Returns 204 and deletes associated local images."
          }
        }
      ]
    },
    {
      "name": "Admin Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Category created', function () { pm.response.to.have.status(201); });",
                "const json = pm.response.json();",
                "if (json.data && json.data.id) pm.collectionVariables.set('categoryId', json.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Backend Engineering\",\n  \"description\": \"APIs, databases, and distributed systems.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/admin/categories", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories"] }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Backend Development\",\n  \"description\": \"Backend architecture, APIs, and databases.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "categories", "{{categoryId}}"] },
            "description": "Returns 409 if any posts still reference the category."
          }
        }
      ]
    }
  ]
}
